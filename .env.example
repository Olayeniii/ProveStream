# Local Hardhat JSON-RPC endpoint.
RPC_URL=http://127.0.0.1:8545

# Set after running `npm run contract:deploy`.
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# The local Hardhat chain ID. Arc testnet/mainnet values can be supplied later.
CHAIN_ID=31337

# Frontend variables are exposed by Vite and intentionally use a separate prefix.
VITE_RPC_URL=http://127.0.0.1:8545
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_CHAIN_ID=31337

