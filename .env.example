# Local Hardhat JSON-RPC endpoint. Point this at Arc testnet's RPC to run for real.
RPC_URL=http://127.0.0.1:8545

# Set after running `npm run contract:deploy`.
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
REWARD_POLICY_ADDRESS=0x0000000000000000000000000000000000000000
REWARD_DISPATCHER_ADDRESS=0x0000000000000000000000000000000000000000
# The block RewardPolicy was deployed at (from the ignition deploy output/journal) —
# PolicyService scans PolicyCreated logs from here instead of genesis, since public
# RPC providers (Arc testnet included) cap eth_getLogs to a 10,000-block range.
# Leave at 0 for local Hardhat.
REWARD_POLICY_DEPLOYED_AT_BLOCK=0

# The local Hardhat chain ID. Set to 5042002 (Arc testnet) to run for real.
CHAIN_ID=31337

# --- Autonomous Settlement Agent ---

# The agent's own wallet, used only to pay gas for calling
# RewardDispatcher.dispatchReward() — it never holds treasury funds.
# Default is Hardhat's well-known local account #2. Never reuse this key
# outside a local demo.
OPERATOR_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a

# --- Treasury (Developer Controlled Wallet) ---
#
# Leave CIRCLE_API_KEY / CIRCLE_ENTITY_SECRET / CIRCLE_TREASURY_WALLET_ID unset
# to run the local demo treasury instead: TREASURY_PRIVATE_KEY sends the
# configured chain's native currency directly via viem, standing in for a real
# Circle Developer Controlled Wallet sending USDC on Arc (Arc's native gas
# token *is* USDC, so the two operations are the same shape).
# Default is Hardhat's well-known local account #3. Never reuse this key
# outside a local demo.
TREASURY_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6

# Get these from https://console.circle.com to use a real Developer
# Controlled Wallet on Arc instead of the local demo treasury above.
# CIRCLE_API_KEY=
# CIRCLE_ENTITY_SECRET=
# CIRCLE_TREASURY_WALLET_ID=
CIRCLE_TREASURY_BLOCKCHAIN=ARC-TESTNET

# --- Embedded wallets (Circle User-Controlled Wallets) ---
#
# Leave unset to disable embedded wallet login; the frontend will report the
# feature as unavailable rather than fail to start.
# CIRCLE_API_KEY=        (shared with the treasury section above)
# CIRCLE_APP_ID=

# --- AI Risk Analysis (optional) ---
#
# Leave GEMINI_API_KEY unset to disable it; the Risk Review panel will show a
# "not available" state rather than fail to start. Get a key from
# https://aistudio.google.com/apikey
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Fraud review (optional) ---
#
# Score (0-100) at or above which the agent holds a payout for admin review
# instead of auto-dispatching it. Leave unset to use FraudService's own
# default of 70.
# FRAUD_SCORE_THRESHOLD=70

# --- Backend API server ---
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Frontend (exposed by Vite; must use the VITE_ prefix) ---
VITE_RPC_URL=http://127.0.0.1:8545
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_REWARD_POLICY_ADDRESS=0x0000000000000000000000000000000000000000
VITE_REWARD_DISPATCHER_ADDRESS=0x0000000000000000000000000000000000000000
VITE_CHAIN_ID=31337
VITE_BACKEND_URL=http://localhost:4000
# VITE_CIRCLE_APP_ID=    (same value as CIRCLE_APP_ID above)
