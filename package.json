{
  "name": "provenance-streams",
  "version": "0.1.0",
  "private": true,
  "description": "An autonomous USDC settlement engine built on Arc.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "agent",
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "build": "npm run contract:compile && npm run build --workspaces --if-present",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "clean": "npm run clean --workspaces --if-present && hardhat clean",
    "contract:compile": "hardhat compile",
    "contract:deploy": "hardhat run scripts/deploy.ts --network localhost",
    "contract:node": "hardhat node",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "hardhat test && npm run test --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-ignition-viem": "^3.1.6",
    "@nomicfoundation/hardhat-keystore": "^3.0.12",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.11",
    "@nomicfoundation/hardhat-node-test-runner": "^3.1.0",
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.7",
    "@nomicfoundation/hardhat-verify": "^3.0.22",
    "@nomicfoundation/hardhat-viem": "^3.0.9",
    "@nomicfoundation/hardhat-viem-assertions": "^3.1.2",
    "@nomicfoundation/ignition-core": "^3.1.9",
    "@types/node": "26.1.1",
    "eslint": "10.8.0",
    "hardhat": "^3.12.0",
    "prettier": "3.9.6",
    "prettier-plugin-solidity": "2.3.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "viem": "2.55.8"
  }
}
